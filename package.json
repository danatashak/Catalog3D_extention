{
  "name": "@catalog3d/embed",
  "version": "1.3.0",
  "description": "Public iframe loader for Catalog3D room experiences",
  "keywords": [
    "3d",
    "catalog3d",
    "ecommerce",
    "embed",
    "iframe",
    "product-visualization",
    "room"
  ],
  "license": "MIT",
  "homepage": "https://catalog3d.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danatashak/Catalog3D_extention.git"
  },
  "bugs": {
    "url": "https://github.com/danatashak/Catalog3D_extention/issues"
  },
  "type": "module",
  "main": "./dist/catalog3d.mjs",
  "module": "./dist/catalog3d.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/catalog3d.js",
  "jsdelivr": "./dist/catalog3d.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/catalog3d.mjs"
    },
    "./browser": "./dist/catalog3d.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "PUBLISHING.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:package": "node scripts/check-package.mjs",
    "example": "node scripts/serve-example.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:package",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
